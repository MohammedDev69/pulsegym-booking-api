# Copy to `.env` for local (non-Docker) runs. Never commit the real file.

# PostgreSQL connection string used by the API.
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulsegym

# HTTP port. The challenge expects 8080.
PORT=8080

# Connection pool size (optional).
PG_POOL_MAX=20

# debug | info | warn | error | silent
LOG_LEVEL=info
